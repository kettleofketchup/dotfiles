# Add custom completions directory to fpath BEFORE compinit
fpath=(~/.config/zsh/completions $fpath)

# Completions are loaded via fpath, not source
# Files: _just, _inv, _invoke

# Completions generated by the tool itself, cached per machine and regenerated
# when the binary is newer than the cache. Lives outside the repo because
# ~/.config/zsh is stow-folded into ~/dotfiles.
_zsh_gen_comp_dir="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/completions"
fpath=("$_zsh_gen_comp_dir" $fpath)

# usage: _zsh_gen_comp <command> <args that print a zsh completion script...>
_zsh_gen_comp() {
  local cmd=$1 bin=${commands[$1]} out="$_zsh_gen_comp_dir/_$1"
  shift
  [[ -n $bin ]] || return 0
  [[ -s $out && ! $bin -nt $out ]] && return 0
  mkdir -p "$_zsh_gen_comp_dir"
  "$bin" "$@" >| "$out.tmp" 2>/dev/null && [[ -s $out.tmp ]] \
    && mv -f "$out.tmp" "$out" || rm -f "$out.tmp"
}

_zsh_gen_comp herdr completion zsh
_zsh_gen_comp mise completion zsh

unset -f _zsh_gen_comp
unset _zsh_gen_comp_dir
